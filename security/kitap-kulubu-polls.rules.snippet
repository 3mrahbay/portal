    // Polls: aggregate counts and options only; individual choices are owner-only.
    // Writes (create/update/close/vote/withdraw) use the authenticated callable.
    // kitabKulubuOylamalar/{id}: type, title, options[{id,label,time}], closesAt,
    // status, counts, total, createdAt, updatedAt. No name/email/creator UID.
    // oylar/{uid}: optionId|null, revision, requestId, updatedAt. No list access.
    // yonetim/*: server-only creator/closer audit, never exposed to clients.
    match /kitapKulubuOylamalar/{pollId} {
      allow get: if kkYazar();
      allow list: if kkYazar() && request.query.limit <= 20;
      allow create, update, delete: if false;
      match /oylar/{uid} {
        allow get: if kkYazar() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/kitapKulubuOylamalar/$(pollId));
        allow list, create, update, delete: if false;
      }
      match /yonetim/{id} { allow read, write: if false; }
    }
