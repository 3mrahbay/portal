// Prototype: existing record fields retained; decision audit is append-only.
// Rollout requires updated Portal and ZEKY decision clients before enforcement.
function ozlukYetkili() { return isSignedIn() && request.auth.token.get('email_verified',false) == true && (isAdmin() || isYonetim() || isKoordinator()); }
function ozlukOkur() { return ozlukYetkili() || isMuhasebe(); }
function ozlukSahibi(email) { return isPersonel() && (email == userEmail() || email == personelEmail()) && !(get(/databases/$(database)/documents/personeller/$(personelEmail())).data.get('durum','aktif') in ['arsiv','pasif','ayrildi']); }
function izinYeniAlanlar(d) {
  return d.keys().hasOnly(['personelEmail', 'tur', 'baslangic', 'durum', 'aciklama', 'gun', 'saat', 'gunlukSaat', 'bakiyedenDuser', 'belgeGerekli', 'personelAd', 'izinTuru', 'turAdi', 'turAd', 'sureTipi', 'bitis', 'baslangicSaat', 'bitisSaat', 'ucretPolitikasi', 'belgeUrl', 'belgeYol', 'belgeAdi', 'belgeTipi', 'kaynak', 'olusturuldu', 'tarihMetin', 'miktarMetin', 'etki', 'etkiMetin', 'yakinlik'])
    && d.get('personelAd','') is string && d.get('personelAd','').size() <= 200
    && d.get('izinTuru','') is string && d.get('izinTuru','').size() <= 50
    && d.get('turAdi','') is string && d.get('turAdi','').size() <= 100
    && d.get('turAd','') is string && d.get('turAd','').size() <= 100
    && d.get('sureTipi','') is string && d.get('sureTipi','').size() <= 30
    && d.get('bitis','') is string && d.get('bitis','').size() <= 10
    && d.get('baslangicSaat','') is string && d.get('baslangicSaat','').size() <= 5
    && d.get('bitisSaat','') is string && d.get('bitisSaat','').size() <= 5
    && d.get('ucretPolitikasi','') is string && d.get('ucretPolitikasi','').size() <= 200
    && d.get('belgeUrl','') is string && d.get('belgeUrl','').size() <= 2000
    && d.get('belgeYol','') is string && d.get('belgeYol','').size() <= 1000
    && d.get('belgeAdi','') is string && d.get('belgeAdi','').size() <= 255
    && d.get('belgeTipi','') is string && d.get('belgeTipi','').size() <= 100
    && d.get('kaynak','') is string && d.get('kaynak','').size() <= 50
    && d.get('olusturuldu','') is string && d.get('olusturuldu','').size() <= 35
    && d.get('tarihMetin','') is string && d.get('tarihMetin','').size() <= 150
    && d.get('miktarMetin','') is string && d.get('miktarMetin','').size() <= 150
    && d.get('etki','') is string && d.get('etki','').size() <= 50
    && d.get('etkiMetin','') is string && d.get('etkiMetin','').size() <= 200
    && d.get('yakinlik','') is string && d.get('yakinlik','').size() <= 100
    && d.get('gunlukSaat',0) is number && d.get('gunlukSaat',0) >= 0 && d.get('gunlukSaat',0) <= 24
    && d.get('bakiyedenDuser',false) is bool && d.get('belgeGerekli',false) is bool;
}
function izinGecerli(d) {
  return d.keys().hasAll(['personelEmail','tur','baslangic','durum'])
    && d.personelEmail is string && d.personelEmail.size() <= 254
    && d.tur is string && d.tur.size() <= 50
    && d.baslangic is string && d.baslangic.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && d.durum in ['bekliyor','beklemede','onaybekliyor','onaylandi','reddedildi']
    && d.get('aciklama','') is string && d.get('aciklama','').size() <= 2000
    && d.get('gun',0) is number && d.get('gun',0) >= 0 && d.get('gun',0) <= 366
    && d.get('saat',0) is number && d.get('saat',0) >= 0 && d.get('saat',0) <= 8784;
}
match /izinTalepleri/{id} {
  allow read: if ozlukOkur() || ozlukSahibi(resource.data.personelEmail);
  allow create: if ozlukSahibi(request.resource.data.personelEmail)
    && izinGecerli(request.resource.data) && izinYeniAlanlar(request.resource.data)
    && request.resource.data.durum == 'bekliyor'
    && !request.resource.data.keys().hasAny(['onaylananGun','kararVeren','kararTarihi','kararNotu'])
    && request.resource.data.get('etki','') != 'inisiyatif';
  allow update: if ozlukYetkili() && izinGecerli(request.resource.data)
    && resource.data.durum in ['bekliyor','beklemede','onaybekliyor']
    && request.resource.data.durum in ['onaylandi','reddedildi']
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['durum','kararVeren','kararTarihi','kararNotu','onaylananGun','etki','etkiMetin'])
    && request.resource.data.kararVeren == userEmail()
    && request.resource.data.kararNotu is string && request.resource.data.kararNotu.size() <= 1000
    && (request.resource.data.durum != 'reddedildi' || request.resource.data.kararNotu.size() > 0)
    && request.resource.data.kararTarihi is string && request.resource.data.kararTarihi.size() <= 35
    && request.resource.data.get('onaylananGun',0) is int
    && request.resource.data.get('onaylananGun',0) >= 0 && request.resource.data.get('onaylananGun',0) <= 366
    && request.resource.data.get('etki','') is string && request.resource.data.get('etki','').size() <= 50
    && request.resource.data.get('etkiMetin','') is string && request.resource.data.get('etkiMetin','').size() <= 200
    && getAfter(/databases/$(database)/documents/ozlukIslemKayitlari/$('izin_' + id)).data.yeniDurum == request.resource.data.durum
    && getAfter(/databases/$(database)/documents/ozlukIslemKayitlari/$('izin_' + id)).data.zaman == request.time;
  allow delete: if false;
}
match /ozlukIslemKayitlari/{id} {
  allow read: if ozlukYetkili();
  allow create: if ozlukYetkili()
    && request.resource.data.keys().hasOnly(['tur','talepId','personelEmail','actor','oncekiDurum','yeniDurum','zaman','kaynak'])
    && request.resource.data.tur == 'izin-karar'
    && request.resource.data.talepId is string && request.resource.data.talepId.size() <= 150
    && id == 'izin_' + request.resource.data.talepId
    && request.resource.data.actor == userEmail()
    && request.resource.data.kaynak in ['portal','zeky']
    && request.resource.data.zaman == request.time
    && request.resource.data.oncekiDurum in ['bekliyor','beklemede','onaybekliyor']
    && request.resource.data.oncekiDurum == get(/databases/$(database)/documents/izinTalepleri/$(request.resource.data.talepId)).data.durum
    && request.resource.data.personelEmail == get(/databases/$(database)/documents/izinTalepleri/$(request.resource.data.talepId)).data.personelEmail
    && request.resource.data.yeniDurum in ['onaylandi','reddedildi']
    && getAfter(/databases/$(database)/documents/izinTalepleri/$(request.resource.data.talepId)).data.durum == request.resource.data.yeniDurum;
  allow update, delete: if false;
}
match /puantaj/{id} {
  allow read: if ozlukOkur() || ozlukSahibi(resource.data.personelEmail);
  // Normal attendance is server callable only. Admin SDK bypasses rules.
  allow create: if ozlukYetkili()
    && request.resource.data.keys().hasOnly(['personelEmail','personelAd','tip','zaman','tarih','yontem','duzelten','onayli'])
    && request.resource.data.personelEmail is string && request.resource.data.personelEmail.size() <= 254
    && request.resource.data.personelAd is string && request.resource.data.personelAd.size() <= 200
    && request.resource.data.tarih.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && request.resource.data.zaman is string && request.resource.data.zaman.size() <= 35
    && id == request.resource.data.personelEmail + '_' + request.resource.data.tarih + '_cikis_duzeltme'
    && request.resource.data.tip == 'cikis' && request.resource.data.yontem == 'duzeltme'
    && request.resource.data.duzelten == userEmail() && request.resource.data.onayli == true
    && getAfter(/databases/$(database)/documents/puantajDuzeltmeleri/$(id)).data.personelEmail == request.resource.data.personelEmail
    && getAfter(/databases/$(database)/documents/puantajDuzeltmeleri/$(id)).data.olusturuldu == request.time;
  allow update, delete: if false;
}
function duzeltmeGecerli(d) {
  return d.personelEmail is string && d.personelEmail.size() <= 254
    && d.personelAd is string && d.personelAd.size() <= 200
    && d.tarih is string && d.tarih.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && d.aciklama is string && d.aciklama.size() >= 5 && d.aciklama.size() <= 1000
    && d.duzelten is string && d.duzelten.size() <= 254;
}
match /puantajDuzeltmeleri/{id} {
  allow read: if ozlukOkur() || ozlukSahibi(resource.data.personelEmail);
  allow create: if ozlukYetkili() && duzeltmeGecerli(request.resource.data)
    && request.resource.data.duzelten == userEmail() && request.resource.data.olusturuldu == request.time
    && ((request.resource.data.get('tur','') == 'cikis-eklendi'
      && request.resource.data.keys().hasOnly(['personelEmail','personelAd','tarih','tur','eklenenSaat','aciklama','duzelten','olusturuldu'])
      && request.resource.data.eklenenSaat.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
      && getAfter(/databases/$(database)/documents/puantaj/$(id)).data.personelEmail == request.resource.data.personelEmail)
      || (request.resource.data.get('durum','') == 'bekliyor'
      && request.resource.data.keys().hasOnly(['personelEmail','personelAd','tarih','yeniDurum','yeniDurumAd','girisSaat','cikisSaat','aciklama','durum','duzelten','duzeltenAd','olusturuldu'])
      && request.resource.data.yeniDurum in ['calisti','izinli','raporlu','gelmedi']
      && request.resource.data.yeniDurumAd is string && request.resource.data.yeniDurumAd.size() <= 100
      && request.resource.data.duzeltenAd is string && request.resource.data.duzeltenAd.size() <= 200
      && request.resource.data.girisSaat is string && request.resource.data.girisSaat.size() <= 5
      && request.resource.data.cikisSaat is string && request.resource.data.cikisSaat.size() <= 5));
  allow update: if ozlukSahibi(resource.data.personelEmail) && duzeltmeGecerli(request.resource.data)
    && resource.data.get('durum','') == 'bekliyor'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['durum','kararVeren','kararZamani'])
    && request.resource.data.durum in ['onayli','itiraz'] && request.resource.data.kararVeren == userEmail()
    && request.resource.data.kararZamani == request.time;
  allow delete: if false;
}

match /personelDurum/{email} {
  allow read: if ozlukOkur() || ozlukSahibi(email);
  allow write: if false; // server callable only
}
